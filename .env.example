# ── Cloud.ru FM (обязательно) ────────────────────────────────────────────────
CLOUDRU_API_KEY=put-your-key-here
# Необязательно — переопределить базовый URL Cloud.ru FM:
# CLOUDRU_BASE_URL=https://foundation-models.api.cloud.ru/v1

# ── App2 (веб-приложение за шлюзом) ───────────────────────────────────────────
# Префикс, под которым шлюз монтирует приложение (в проде "/slides").
# Пусто = standalone-режим без шлюза. Шлюз снимает префикс перед проксированием,
# поэтому роуты живут в корне, а фронт добавляет префикс к URL в браузере.
APP_PREFIX=/slides
# Адрес/порт апстрима (шлюз ходит сюда по loopback). По контракту App2 слушает
# ТОЛЬКО 127.0.0.1:8012 — наружу не биндить, публичная точка входа одна (шлюз).
HOST=127.0.0.1
PORT=8012
# Хранилище истории/задач. По умолчанию SQLite в DATA_DIR.
DB_URL=sqlite+aiosqlite:///./data/app2.db
DATA_DIR=./data
# Сколько сборок идут параллельно (остальные ждут в очереди).
BUILD_WORKERS=3
# Общий потолок задач в системе (running + waiting) — предохранитель от перегруза.
QUEUE_MAX_ACTIVE=60
# Сколько активных сборок может держать один пользователь.
USER_QUEUE_LIMIT=3
# Переопределить модель движка по умолчанию (MiniMaxAI/MiniMax-M3) для A/B.
# CLOUDRU_MODEL=MiniMaxAI/MiniMax-M3
# Где лежат сессии (загруженный файл, plan.json, собранная дека). По умолчанию —
# временный каталог ОС. В проде задавать ОБЯЗАТЕЛЬНО и на реальном диске:
# systemd-юнит поднят с PrivateTmp=true, поэтому /tmp у сервиса свой и systemd
# сносит его при КАЖДОЙ остановке — без этой переменной все деки исчезали при
# рестарте, а история продолжала показывать «Готово» (скачивание → 404).
SLIDESBOT_WORKDIR=/opt/app2/data/sessions
# TTL результатов: сессии и строки Job старше этого срока удаляются.
RETENTION_HOURS=24
# Временный архив фактуры: перед удалением по RETENTION_HOURS сессия
# упаковывается сюда (<sid>.tar.gz со входом и выходом + <sid>.json с метриками
# прогона). Нужен, чтобы видеть на реальных кейсах, где движок ошибается.
# ПУСТО = выключено (нормальное состояние локалки). Каталог должен быть в
# ReadWritePaths юнита; права ставятся 700 — внутри сырой пользовательский контент.
ARCHIVE_DIR=
ARCHIVE_TTL_DAYS=14
# Потолок на диск: сверх него вытесняются самые старые архивы.
ARCHIVE_MAX_MB=4096
# Общий с платформой секрет для GET /internal/stats (заголовок X-Ingest-Token):
# шлюз читает им метрики /slides под блок «Слайды» в админке. Имя историческое —
# раньше тем же секретом подписывался снятый пуш на /internal/usage. Пусто =
# эндпоинт выключен (404), нормальное состояние локалки.
USAGE_INGEST_TOKEN=
# Локальная разработка без шлюза: подставлять этот user_id, если нет X-User-Id.
# В проде ОБЯЗАТЕЛЬНО пусто — тогда отсутствие X-User-Id = жёсткий 401.
DEV_USER_ID=
