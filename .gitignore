# Крупные раздаваемые бинарники (см. settings.downloads_dir) — кладутся scp-ом
downloads/

# Рабочие папки на машине автора: готовые деки, выгрузки прогонов и отчёты с
# ассетами. В репозитории им не место — это результаты, а не исходники, и
# весят они сотни мегабайт (reports/ — под 300 МБ, в основном отбраковка
# картинок). Без этих строк один неосторожный `git add .` затягивает их все.
reports/
research_notes/
slide decks/
slides_eval_out/
